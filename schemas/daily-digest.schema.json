{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:porchlight:daily-digest:1.0",
  "title": "Evidence-linked digest of supplied event records",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          }
        },
        "required": [
          "text",
          "event_ids"
        ]
      },
      "minItems": 0,
      "maxItems": 8
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  },
  "required": [
    "schema_version",
    "summary",
    "highlights",
    "coverage_note"
  ]
}
